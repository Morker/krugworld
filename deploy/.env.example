# Copy to .env on the server and fill in. Never commit the real .env.
# Generate one with:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# The Steward (AI helper). Leave both keys empty and its page simply says
# it's unavailable. Pick the provider that has the key:
#   anthropic -> Claude (ANTHROPIC_API_KEY)
#   openai    -> OpenAI (OPENAI_API_KEY)
KRUGWORLD_STEWARD_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
