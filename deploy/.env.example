# Copy to .env on the server and fill in. Never commit the real .env.
# Generate one with:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# The Steward (AI helper). OpenAI is the default and is all you need: the
# same key will also give Gaby (the ESP32 device) its ears and voice.
# Leave it empty and the Steward page simply says it's unavailable.
OPENAI_API_KEY=
# Optional: answer with Claude instead (Gaby would still use OpenAI for speech).
# KRUGWORLD_STEWARD_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Password reset by email (optional; leave SMTP_HOST empty to keep it off).
# Gmail: turn on 2-step verification, create an "App password" at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD
# (never your real Google password). MAIL_FROM must be the same Gmail address.
# Use port 587 (STARTTLS): many clouds, Tencent included, block port 25.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=
# MAIL_FROM=you@gmail.com
# The address people open the app at; reset links point here.
# PUBLIC_URL=https://krugworld.veteryr.online
